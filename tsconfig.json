{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mts", "**/*.mjs", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", ".next-gate/types/**/*.ts", ".next-gate/dev/types/**/*.ts"],
  "exclude": ["node_modules", ".next", ".next-*", "dist", "var", "test-results", "playwright-report", "spec"]
}
