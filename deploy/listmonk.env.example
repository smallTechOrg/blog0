# Listmonk env for the GCP VM (Stage B, spec/architecture.md §12.7; runbook docs/deploy-gcp.md).
#   cp deploy/listmonk.env.example deploy/listmonk.env && chmod 600 deploy/listmonk.env   (never commit it)
# Placeholders only. Docker env-file rules: no quotes, no inline comments after a value.

# --- Read by Listmonk (LISTMONK_<section>__<key> = config.toml's [section] key) ----------------------
# Cloud SQL through the proxy sidecar; user `listmonk` owns database `listmonk` and its public schema.
LISTMONK_db__host=cloud-sql-proxy
LISTMONK_db__port=5432
LISTMONK_db__user=listmonk
LISTMONK_db__password=<listmonk-db-password>
LISTMONK_db__database=listmonk
# The proxy encrypts to Cloud SQL; the in-VM hop is plain TCP.
LISTMONK_db__ssl_mode=disable
# Connection budget on db-g1-small: Listmonk ≤ 10 + blog0's pool + the hourly tick.
LISTMONK_db__max_open=10
LISTMONK_db__max_idle=5
# First-run Super Admin (`--install` reads these once); also the basic auth listmonk-settings.sh uses.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=<listmonk-admin-password>

# --- Read by deploy/listmonk-settings.sh only (Listmonk keeps these in its database) ----------------
# Public base of tracking links, the open pixel and the unsubscribe page (Caddy's news host).
LISTMONK_ROOT_URL=https://news.<domain>
# Default From of campaigns: the Workspace mailbox (or a verified alias of it).
LISTMONK_FROM_EMAIL=<Blog Name> <newsletter@domain>
# Google Workspace SMTP: STARTTLS on 587 with the mailbox's app password.
LISTMONK_SMTP_HOST=smtp.gmail.com
LISTMONK_SMTP_PORT=587
LISTMONK_SMTP_USER=<newsletter@domain>
LISTMONK_SMTP_PASSWORD=<workspace-app-password>
# STARTTLS | TLS | none
LISTMONK_SMTP_TLS=STARTTLS
# Bounce processing (POP on the same mailbox; Gmail sets Return-Path to the authenticated account).
# Leave LISTMONK_BOUNCE_POP_HOST empty to keep bounce processing off.
LISTMONK_BOUNCE_POP_HOST=pop.gmail.com
LISTMONK_BOUNCE_POP_PORT=995
LISTMONK_BOUNCE_POP_USER=<newsletter@domain>
LISTMONK_BOUNCE_POP_PASSWORD=<workspace-app-password>
