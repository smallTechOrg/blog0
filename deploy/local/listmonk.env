# Listmonk env for LOCAL verification only (committed, dev-only values). Template: deploy/listmonk.env.example.
LISTMONK_db__host=cloud-sql-proxy
LISTMONK_db__port=5432
LISTMONK_db__user=listmonk
LISTMONK_db__password=listmonk
LISTMONK_db__database=listmonk
LISTMONK_db__ssl_mode=disable
LISTMONK_db__max_open=10
LISTMONK_db__max_idle=5
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=local-verify-listmonk-admin
# Read by deploy/listmonk-settings.sh (not by Listmonk): root URL + SMTP → Mailpit, no bounces.
LISTMONK_ROOT_URL=https://news.localtest.me:8443
LISTMONK_FROM_EMAIL=blog0 local <newsletter@localtest.me>
LISTMONK_SMTP_HOST=mailpit
LISTMONK_SMTP_PORT=1025
LISTMONK_SMTP_USER=
LISTMONK_SMTP_PASSWORD=
LISTMONK_SMTP_TLS=none
LISTMONK_BOUNCE_POP_HOST=
