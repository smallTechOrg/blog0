# Local verification only (deploy/docker-compose.local.yml; committed, dev-only values).
BLOG0_IMAGE_TAG=prodlocal
# Unused locally (the proxy is behind the `gcp` profile) but the prod file requires a value.
CLOUD_SQL_INSTANCE=local:stand-in:unused
# The local Postgres major (= the Cloud SQL major chosen in spec/architecture.md §12.7).
CLOUD_SQL_MAJOR=18
BLOG0_DOMAIN=blog.localtest.me
NEWS_DOMAIN=news.localtest.me
ACME_EMAIL=ops@localtest.me
# Caddy's own CA instead of ACME (curl --insecure / accept the certificate in the browser).
CADDY_LOCAL_CERTS=local_certs
MEDIA_BACKUP_DEST=/backup/media
