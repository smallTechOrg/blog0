# Inputs (sourced by bash: quote values with spaces) to deploy/vm/render-env.sh for LOCAL verification only (deploy/local/verify.sh; committed,
# dev-only values - never reuse them). In CI/production the same names come from GitHub secrets/variables.
GCP_PROJECT=blog0-local
GCP_REGION=us-central1
AR_REPO=blog0
BACKUP_BUCKET=blog0-local-backups
SITE_DOMAIN=blog.localtest.me
# The local Postgres (service `postgres`, TLS on, roles from deploy/local/init-db.sh) stands in for Cloud SQL.
CLOUDSQL_PRIVATE_IP=postgres
BLOG0_SESSION_SECRET=local-verify-only-session-secret-not-for-production-0123456789
BLOG0_UNSUBSCRIBE_SECRET=local-verify-only-unsubscribe-secret-0123456789
BLOG0_NEWSLETTER_WEBHOOK_SECRET=local-verify-only-webhook-secret-0123456789
# Placeholder: the site boots, Jev's Generate answers LLM_NOT_CONFIGURED (the seeded decks are fixtures).
BLOG0_OPENROUTER_API_KEY=pending-placeholder
BLOG0_DB_OWNER_PASSWORD=local-owner-password-0001
BLOG0_DB_APP_PASSWORD=local-app-password-000001
LISTMONK_DB_PASSWORD=local-listmonk-db-password-01
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=local-verify-listmonk-admin
BLOG0_ADMIN_EMAIL=admin@localtest.me
BLOG0_ADMIN_NAME="Local Verify"
BLOG0_ADMIN_PASSWORD=local-verify-admin-password
# SMTP = Mailpit (no TLS, no auth - render-env.sh drops Listmonk auth when TLS=none): nothing can reach a real relay.
BLOG0_SMTP_HOST=mailpit
BLOG0_SMTP_PORT=1025
BLOG0_SMTP_USER=local-smtp-user
BLOG0_SMTP_PASS=local-smtp-pass-0001
BLOG0_SMTP_FROM="blog0 local <newsletter@localtest.me>"
LISTMONK_SMTP_TLS=none
LISTMONK_BOUNCE_POP_HOST=off
