# blog0 runtime env for LOCAL verification only (committed, dev-only values — never reuse them).
# Production template: deploy/blog0.env.example.
BLOG0_DATABASE_URL=postgres://blog0:blog0@cloud-sql-proxy:5432/blog0
BLOG0_PUBLIC_BASE_URL=https://blog.localtest.me:8443
BLOG0_SITE_SLUG=blog0
BLOG0_TRUSTED_PROXY_HOPS=1
BLOG0_SESSION_SECRET=local-verify-only-session-secret-not-for-production-0123456789
# Placeholder: the site boots, Jev's Generate answers LLM_NOT_CONFIGURED (the seeded decks are fixtures).
BLOG0_OPENROUTER_API_KEY=pending-placeholder
BLOG0_ADMIN_EMAIL=admin@localtest.me
BLOG0_ADMIN_PASSWORD=local-verify-admin-password
BLOG0_ADMIN_NAME=Local Verify
BLOG0_LOG_LEVEL=info
# Newsletter: blog0's own SMTP stays unset (stub transport) and the issue sender is the stub —
# nothing blog0 does locally can reach a real relay. Listmonk's SMTP is Mailpit (listmonk-settings.sh).
BLOG0_SMTP_HOST=
BLOG0_NEWSLETTER_SENDER=stub
BLOG0_HEARTBEAT_BACKUP_URL=
BLOG0_HEARTBEAT_TICK_URL=
