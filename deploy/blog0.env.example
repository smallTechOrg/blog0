# blog0 runtime env for the GCP VM (Stage B, spec/architecture.md §12.7; runbook docs/deploy-gcp.md).
#   cp deploy/blog0.env.example deploy/blog0.env && chmod 600 deploy/blog0.env   (never commit it)
# Read by the release, blog0 and scheduler services (deploy/docker-compose.prod.yml → env_file).
# Placeholders only — replace every <…> value. Docker env files take each line literally: no quotes,
# no inline comments after a value. Set by the image, NOT here: BLOG0_PORT (3410), BLOG0_STORAGE_DIR
# (/data/storage), NODE_ENV, PORT, HOSTNAME.

# --- Database (Cloud SQL through the proxy sidecar; plain TCP on the in-VM hop) ---------------------
# User `blog0` owns database `blog0` and its `public` schema (non-superuser, the Cloud SQL shape).
# URL-encode special characters in the password.
BLOG0_DATABASE_URL=postgres://blog0:<blog0-db-password>@cloud-sql-proxy:5432/blog0

# --- Server ------------------------------------------------------------------------------------------
# Absolute public origin (links, OG tags, CSRF origin check, Secure cookie).
BLOG0_PUBLIC_BASE_URL=https://<domain>
# Which `site` row this deployment serves (created by the release step).
BLOG0_SITE_SLUG=blog0
# Caddy is the one proxy in front of blog0 and appends to X-Forwarded-For.
BLOG0_TRUSTED_PROXY_HOPS=1
# auto = throttles counted in Postgres.
BLOG0_RATE_LIMIT_STORE=auto
# In-flight requests drain this long after SIGTERM (compose stop_grace_period is 15 s).
BLOG0_SHUTDOWN_TIMEOUT_MS=8000
# debug | info | warn | error (JSON lines on stdout → docker logs).
BLOG0_LOG_LEVEL=info
# Optional extra JSON log file inside the container (normally empty: docker logs is the log).
BLOG0_LOG_FILE=

# --- Secrets -----------------------------------------------------------------------------------------
# ≥ 32 characters: openssl rand -base64 48
BLOG0_SESSION_SECRET=<openssl-rand-base64-48>
# Optional, ≥ 24 characters (openssl rand -base64 32): signs new unsubscribe links (unset → session secret).
BLOG0_UNSUBSCRIBE_SECRET=

# --- First admin (release step; an existing admin's password is never reset) ------------------------
# Set both on the first `up`, then you may blank the password (reset later: docker compose exec blog0
# node reset-password.mjs --email <address>).
BLOG0_ADMIN_EMAIL=<you@domain>
BLOG0_ADMIN_PASSWORD=<12-plus-character-password>
BLOG0_ADMIN_NAME=<Your Name>

# --- Jev (TLDR ranker, OpenRouter decisions API) -----------------------------------------------------
BLOG0_OPENROUTER_API_KEY=<openrouter-api-key>
BLOG0_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BLOG0_OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
BLOG0_JEV_MODEL=typesafe/jev-1.13
BLOG0_JEV_TIMEOUT_MS=45000

# --- Media limits (uploads live on the blog0-storage volume; backed up daily to GCS) ----------------
BLOG0_MAX_AUDIO_MB=50
BLOG0_MAX_AUDIO_MINUTES=30
BLOG0_MAX_IMAGE_MB=8

# --- Newsletter: confirmation / test mail (Google Workspace SMTP, STARTTLS, app password) -----------
BLOG0_SMTP_HOST=smtp.gmail.com
BLOG0_SMTP_PORT=587
# The Workspace mailbox and its 16-character app password (2-Step Verification required).
BLOG0_SMTP_USER=<newsletter@domain>
BLOG0_SMTP_PASS=<workspace-app-password>
# That mailbox or a verified Send-as alias of it.
BLOG0_SMTP_FROM=<Blog Name> <newsletter@domain>

# --- Newsletter: issue sender (Listmonk on the compose network) -------------------------------------
BLOG0_NEWSLETTER_SENDER=listmonk
BLOG0_LISTMONK_URL=http://listmonk:9000
# A Listmonk API user (Listmonk admin → Users → New, type API) and its token (shown once).
BLOG0_LISTMONK_API_USER=blog0
BLOG0_LISTMONK_API_TOKEN=<listmonk-api-token>
# Id of the list named `blog0` (Listmonk admin → Lists).
BLOG0_LISTMONK_LIST_ID=<list-id>
# Optional, ≥ 24 characters: bearer secret for POST /api/newsletter/webhook (unset → 404).
BLOG0_NEWSLETTER_WEBHOOK_SECRET=

# --- Heartbeats (optional dead-man's switches, e.g. healthchecks.io; the URL is a secret) -----------
# Pinged by the scheduler's daily media backup (GET <url>, or <url>/fail).
BLOG0_HEARTBEAT_BACKUP_URL=
# Pinged by the hourly newsletter tick.
BLOG0_HEARTBEAT_TICK_URL=
