# Compose interpolation for deploy/docker-compose.prod.yml (Stage B, spec/architecture.md §12.7).
#   cp deploy/compose.env.example deploy/compose.env
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/compose.env up -d --build --wait
# Placeholders only; no secret lives here.

# Image tag of blog0 / blog0-scheduler built on the VM: the short git SHA (rollback = the previous tag).
#   BLOG0_IMAGE_TAG=$(git rev-parse --short HEAD)
BLOG0_IMAGE_TAG=<short-git-sha>
# Cloud SQL instance connection name (gcloud sql instances describe <instance> --format='value(connectionName)').
CLOUD_SQL_INSTANCE=<project>:<region>:<instance>
# The site and Listmonk's public host (A records → the VM's static IP).
BLOG0_DOMAIN=<domain>
NEWS_DOMAIN=news.<domain>
# Let's Encrypt account e-mail (certificate expiry notices).
ACME_EMAIL=<ops@domain>
# Empty in production (ACME certificates). `local_certs` only for local verification.
CADDY_LOCAL_CERTS=
# rclone destination of the daily media backup (bucket with versioning + 30-day noncurrent lifecycle;
# auth = the VM's service account via env_auth).
MEDIA_BACKUP_DEST=:gcs,env_auth=true,bucket_policy_only=true:<bucket>/media
