# blog0 — environment. Copy to .env (gitignored) and fill the REQUIRED values:
#   cp .env.example .env
# Designer mode needs NO .env at all: `pnpm install && pnpm dev:design` (embedded PGlite, generated
# session secret + designer admin, Jev disabled until a key is added). See README → Designer mode.
# Every variable below is read by src/server/config.ts, scripts/serve.mjs, next.config.ts or the test
# harness (documented 1:1 with spec/architecture.md §10).
# Scripts, tests and `pnpm start` load .env themselves via @next/env.
# Never commit .env; never paste real keys anywhere else.

# --- Database ------------------------------------------------------------------------------
# Dev database used by `pnpm dev` / `pnpm start` / `pnpm db:*`. Engine by scheme:
#   postgres://user@host:5432/db  → server PostgreSQL (the production engine; required for tests + deploy)
#   pglite://./var/pglite         → embedded PGlite (Postgres 17 in WASM) persisted in that directory
#   (unset or empty)              → embedded PGlite at ./var/pglite, with a boot notice
# On pglite:// BLOG0_SESSION_SECRET and BLOG0_OPENROUTER_API_KEY become optional. `pnpm dev:design`
# always uses pglite:// (it ignores a postgres:// value here).
BLOG0_DATABASE_URL=postgres://sai@localhost:5432/blog0_dev
# Test database used by integration + E2E tests. MUST differ from BLOG0_DATABASE_URL (tests refuse otherwise).
BLOG0_TEST_DATABASE_URL=postgres://sai@localhost:5432/blog0_test

# --- Server --------------------------------------------------------------------------------
# Port for `pnpm dev` / `pnpm start` / `pnpm dev:design` (read by scripts/serve.mjs). Default 3410.
BLOG0_PORT=3410
# Next.js build directory for `pnpm build` / `pnpm start` / `pnpm dev` (default .next). Set a
# separate dir (e.g. BLOG0_DIST_DIR=.next-gate) so gate builds don't overwrite a running server's
# build; build and start with the same value. Leave empty for .next.
BLOG0_DIST_DIR=
# Absolute public origin: links, OG tags, CSRF origin check, Secure cookie when https.
BLOG0_PUBLIC_BASE_URL=http://localhost:3410
# Which `site` row this process serves.
BLOG0_SITE_SLUG=blog0
# Reverse proxies in front of the app that append to X-Forwarded-For (login throttling uses the
# Nth-from-right entry; so does the newsletter per-IP cap). 0 = no proxy: X-Forwarded-For / X-Real-IP
# are client-controlled and ignored, and the newsletter per-IP cap is skipped.
BLOG0_TRUSTED_PROXY_HOPS=0

# Where the sign-in / newsletter throttles count attempts: auto (default) = in Postgres on postgres://
# (caps survive restarts and are shared across instances), in memory on pglite:// (designer mode);
# db / memory force one. Integration tests set memory (tests/setup/integration-env.ts).
BLOG0_RATE_LIMIT_STORE=auto

# Graceful shutdown: after SIGTERM/SIGINT in-flight requests drain for up to this many ms (1000–120000),
# then the DB pool closes and the process exits (1 if the deadline was hit). `pnpm start`/`pnpm dev`
# kill the server this + 5000 ms after the signal. Platform stop grace periods must exceed it by ≥ 2 s.
BLOG0_SHUTDOWN_TIMEOUT_MS=8000

# --- Secrets (REQUIRED on postgres://; optional on pglite://) -------------------------------
# Session HMAC secret, at least 32 characters. Generate with: openssl rand -base64 48
# pglite:// without it: generated once into var/pglite-session-secret (mode 0600).
BLOG0_SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48
# OpenRouter API key (https://openrouter.ai/keys). Validate with: pnpm check:openrouter
# pglite:// without a real key: the site works, Jev's Generate answers LLM_NOT_CONFIGURED and the
# TLDR tab says "No OpenRouter key configured".
BLOG0_OPENROUTER_API_KEY=replace-with-your-openrouter-key

# --- LLM (Jev, the TLDR agent) -------------------------------------------------------------
BLOG0_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model slug (see spec/agent.md §3). `pnpm check:openrouter` proves it with one real call.
BLOG0_JEV_MODEL=google/gemini-2.5-flash
# Per model attempt timeout in milliseconds.
BLOG0_JEV_TIMEOUT_MS=45000

# --- Logging -------------------------------------------------------------------------------
# debug | info | warn | error
BLOG0_LOG_LEVEL=info
# Optional: also append JSON log lines to this file (E2E sets it to test-results/e2e-server.log).
BLOG0_LOG_FILE=

# --- First admin (seed + E2E) --------------------------------------------------------------
# Used by `pnpm db:seed` and the E2E suite. Password at least 12 characters.
BLOG0_ADMIN_EMAIL=you@example.com
BLOG0_ADMIN_PASSWORD=replace-with-a-12-plus-char-password
BLOG0_ADMIN_NAME=Sai Krishna V
# Optional: password for a non-interactive `pnpm admin:create`.
BLOG0_NEW_ADMIN_PASSWORD=

# --- Media ---------------------------------------------------------------------------------
# Audio/image storage + upload limits.
BLOG0_STORAGE_DIR=./var/storage
BLOG0_MAX_AUDIO_MB=50
BLOG0_MAX_AUDIO_MINUTES=30
BLOG0_MAX_IMAGE_MB=8

# --- Newsletter: transactional mail (Phase 7, spec/architecture.md §13.2) --------------------
# SMTP host for confirmation / test messages. Unset or empty → the STUB transport (designer mode,
# tests, E2E; a production process logs one newsletter.mail_not_configured warning). Designer mode
# never needs SMTP.
BLOG0_SMTP_HOST=
# 1–65535, default 587. 465 → implicit TLS; anything else → STARTTLS.
BLOG0_SMTP_PORT=587
# Credentials: set both, or leave both empty for an unauthenticated (IP-allowlisted) relay.
BLOG0_SMTP_USER=
BLOG0_SMTP_PASS=replace-with-smtp-password
# Required with BLOG0_SMTP_HOST: `Name <address>` or a bare address — the From of every message.
# The stub transport uses `blog0 <newsletter@localhost>`.
BLOG0_SMTP_FROM=blog0 <newsletter@example.com>

# --- Newsletter: issue sender (spec/architecture.md §13.3) ----------------------------------
# listmonk | stub (default). listmonk requires all four BLOG0_LISTMONK_* values below.
BLOG0_NEWSLETTER_SENDER=stub
# Listmonk base URL, no trailing slash: http://localhost:9000 (compose from the host) or
# http://listmonk:9000 (same compose network).
BLOG0_LISTMONK_URL=http://localhost:9000
# A Listmonk API user (Listmonk ≥ v4: Settings → Users) and its token.
BLOG0_LISTMONK_API_USER=
BLOG0_LISTMONK_API_TOKEN=replace-with-listmonk-api-token
# Integer id of the one list blog0 mirrors into (create it by hand or with
# `pnpm newsletter:sync --create-list`).
BLOG0_LISTMONK_LIST_ID=
# Optional bearer secret for POST /api/newsletter/webhook, at least 24 characters
# (openssl rand -base64 32). Unset → the webhook answers 404.
BLOG0_NEWSLETTER_WEBHOOK_SECRET=

# --- E2E -----------------------------------------------------------------------------------
# Optional: point Playwright at an already-running server instead of starting `pnpm start` on 3411.
BLOG0_E2E_BASE_URL=
# Optional, with BLOG0_E2E_BASE_URL: host path of that server's JSON log (the container of
# `pnpm test:container` writes it through a bind mount; the script sets test-results/e2e-server.log).
# Unset with an external base URL → the log-asserting E2E tests skip ("log file not wired").
BLOG0_E2E_LOG_FILE=
# Optional, `pnpm test:container` only: auto (default — rebuild blog0:local only when a build-context
# file is newer than the image) | always | never.
# BLOG0_CONTAINER_BUILD=auto
# BLOG0_STANDALONE (image build only — never set locally)

# --- Real-key tests ------------------------------------------------------------------------
# Test harness/scripts only. 1 → a missing/placeholder BLOG0_OPENROUTER_API_KEY FAILS the real-key
# tests; 0 → they skip as PENDING KEY; empty → CI=true decides (CI sets it from secret presence).
BLOG0_REQUIRE_REAL_KEY=
