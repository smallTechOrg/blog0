# blog0 — environment. Copy to .env (gitignored) and fill the REQUIRED values:
#   cp .env.example .env
# Designer mode needs NO .env at all: `pnpm install && pnpm dev:design` (embedded PGlite, generated
# session secret + designer admin, Jev disabled until a key is added). See README → Designer mode.
# Every variable below is read by src/server/config.ts (documented 1:1 with spec/architecture.md §10).
# Scripts, tests and `pnpm start` load .env themselves via @next/env.
# Never commit .env; never paste real keys anywhere else.

# --- Database ------------------------------------------------------------------------------
# Dev database used by `pnpm dev` / `pnpm start` / `pnpm db:*`. Engine by scheme:
#   postgres://user@host:5432/db  → server PostgreSQL (the production engine; required for tests + deploy)
#   pglite://./var/pglite         → embedded PGlite (Postgres 17 in WASM) persisted in that directory
#   (unset or empty)              → embedded PGlite at ./var/pglite, with a boot notice
# On pglite:// BLOG0_SESSION_SECRET and BLOG0_OPENROUTER_API_KEY become optional. `pnpm dev:design`
# always uses pglite:// (it ignores a postgres:// value here).
BLOG0_DATABASE_URL=postgres://sai@localhost:5432/blog0_dev
# Test database used by integration + E2E tests. MUST differ from BLOG0_DATABASE_URL (tests refuse otherwise).
BLOG0_TEST_DATABASE_URL=postgres://sai@localhost:5432/blog0_test

# --- Server --------------------------------------------------------------------------------
# Port for `pnpm dev` / `pnpm start` / `pnpm dev:design` (read by scripts/serve.mjs). Default 3410.
BLOG0_PORT=3410
# Next.js build directory for `pnpm build` / `pnpm start` / `pnpm dev` (default .next). Set a
# separate dir (e.g. BLOG0_DIST_DIR=.next-gate) so gate builds don't overwrite a running server's
# build; build and start with the same value. Leave empty for .next.
BLOG0_DIST_DIR=
# Absolute public origin: links, OG tags, CSRF origin check, Secure cookie when https.
BLOG0_PUBLIC_BASE_URL=http://localhost:3410
# Which `site` row this process serves.
BLOG0_SITE_SLUG=blog0
# Reverse proxies in front of the app that append to X-Forwarded-For (login throttling uses the
# Nth-from-right entry). 0 = no proxy: X-Forwarded-For / X-Real-IP are client-controlled and ignored.
BLOG0_TRUSTED_PROXY_HOPS=0

# --- Secrets (REQUIRED on postgres://; optional on pglite://) -------------------------------
# Session HMAC secret, at least 32 characters. Generate with: openssl rand -base64 48
# pglite:// without it: generated once into var/pglite-session-secret (mode 0600).
BLOG0_SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48
# OpenRouter API key (https://openrouter.ai/keys). Validate with: pnpm check:openrouter
# pglite:// without a real key: the site works, Jev's Generate answers LLM_NOT_CONFIGURED and the
# TLDR tab says "No OpenRouter key configured".
BLOG0_OPENROUTER_API_KEY=replace-with-your-openrouter-key

# --- LLM (Jev, the TLDR agent) -------------------------------------------------------------
BLOG0_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model slug (see spec/agent.md §3). `pnpm check:openrouter` proves it with one real call.
BLOG0_JEV_MODEL=google/gemini-2.5-flash
# Per model attempt timeout in milliseconds.
BLOG0_JEV_TIMEOUT_MS=45000

# --- Logging -------------------------------------------------------------------------------
# debug | info | warn | error
BLOG0_LOG_LEVEL=info
# Optional: also append JSON log lines to this file (E2E sets it to test-results/e2e-server.log).
BLOG0_LOG_FILE=

# --- First admin (seed + E2E) --------------------------------------------------------------
# Used by `pnpm db:seed` and the E2E suite. Password at least 12 characters.
BLOG0_ADMIN_EMAIL=you@example.com
BLOG0_ADMIN_PASSWORD=replace-with-a-12-plus-char-password
BLOG0_ADMIN_NAME=Sai Krishna V
# Optional: password for a non-interactive `pnpm admin:create`.
BLOG0_NEW_ADMIN_PASSWORD=

# --- Media (Phase 3) -----------------------------------------------------------------------
BLOG0_STORAGE_DIR=./var/storage
BLOG0_MAX_AUDIO_MB=50
BLOG0_MAX_AUDIO_MINUTES=30
BLOG0_MAX_IMAGE_MB=8

# --- E2E (Phase 5) -------------------------------------------------------------------------
# Optional: point Playwright at an already-running server instead of starting `pnpm start` on 3411.
BLOG0_E2E_BASE_URL=
