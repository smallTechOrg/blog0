# dependencies
node_modules/

# Next.js build output
.next/
# alternate build dirs (BLOG0_DIST_DIR, e.g. .next-gate)
.next-*/
out/
# release-step bundle (pnpm build:release → dist/release.mjs; built inside the image)
dist/
next-env.d.ts
*.tsbuildinfo

# secrets — .env.example is committed, every real value lives in .env
.env
.env.*.local
.env.local
# docker-compose `--profile app` env file (runbook); var/listmonk-dev.env is covered by var/ below
blog0.env
# Stage B deploy kit: the real env files beside their templates (deploy/*.env.example) never get
# committed; deploy/local/*.env are committed dev-only values for `pnpm deploy:local`.
/deploy/*.env
!/deploy/local/*.env

# runtime data (storage, backups)
var/

# test output
test-results/
playwright-report/
blob-report/
coverage/

# OS
.DS_Store
