{
  "name": "blog0",
  "version": "0.1.0",
  "private": true,
  "description": "blog0 — smallTech's AI-native, multi-format publishing platform (public wordmark blog0)",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22 <23"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:create": "tsx scripts/db-create.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "check:openrouter": "tsx scripts/check-openrouter.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "tsx scripts/db-seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "eval:jev": "tsx scripts/eval-jev.ts",
    "spike:pglite": "tsx scripts/spike-pglite.ts",
    "db:seed:posts": "tsx scripts/db-seed-posts.ts",
    "seed:tldr": "tsx scripts/seed-tldr.ts",
    "dev:design": "node scripts/dev-design.mjs",
    "test:e2e:design": "playwright test -c playwright.design.config.ts",
    "release": "tsx scripts/release.ts",
    "build:release": "node scripts/build-release.mjs",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test:container": "bash scripts/container-e2e.sh",
    "newsletter:sync": "tsx scripts/newsletter-sync.ts",
    "newsletter:tick": "tsx scripts/newsletter-tick.ts",
    "listmonk:up": "bash scripts/listmonk-dev.sh up",
    "listmonk:down": "bash scripts/listmonk-dev.sh down",
    "listmonk:reset": "bash scripts/listmonk-dev.sh reset",
    "listmonk:test-up": "bash scripts/listmonk-dev.sh test-up",
    "listmonk:test-down": "bash scripts/listmonk-dev.sh test-down",
    "admin:reset-password": "tsx scripts/reset-password.ts",
    "deploy:local": "bash deploy/local/verify.sh",
    "lm:prefix-check": "bash scripts/lm-prefix-check.sh",
    "deploy:smoke": "bash scripts/deploy-smoke.sh",
    "pg:compat": "bash scripts/pg-compat.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@next/env": "16.4.0",
    "@node-rs/argon2": "2.2.2",
    "@shikijs/rehype": "4.5.0",
    "drizzle-orm": "0.45.4",
    "image-size": "^2.0.4",
    "music-metadata": "^12.1.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.7",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "tsx": "4.23.15",
    "unified": "11.0.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
